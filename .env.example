# Copy this file to .env and fill in your values
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# Admin account (auto-created on first run)
ADMIN_NAME=Shop Owner
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=admin12345

# Store details
STORE_NAME=FreshSabji
DELIVERY_CHARGE=30
FREE_DELIVERY_ABOVE=300

# WhatsApp via Twilio (https://www.twilio.com/whatsapp)
# Leave blank to only log messages in the console (testing mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number is whatsapp:+14155238886 ; later replace with your approved number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Owner gets a copy of every order on this number (10 digit or +91...)
OWNER_WHATSAPP=
   RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
   RAZORPAY_KEY_SECRET=xxxxxxxx